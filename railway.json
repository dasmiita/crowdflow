{
  "$schema": "https://railway.app/railway-schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "nixPkgs": ["python3", "python3Packages.pip"]
        },
        "install": {
          "cmds": ["pip install -r requirements.txt"]
        }
      },
      "start": {
        "cmd": "gunicorn config.wsgi --log-file -"
      }
    }
  }
}